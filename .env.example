# ============================================================================
# SECTION A — Justfile / deploy configuration
#   Consumed by: justfile recipes + docker-compose.*.yml at deploy time
#   Loaded by:   `set dotenv-load` in justfile
# ============================================================================

# Dev host endpoint. Required for dev-up, dev-down, test, logs dev, shell dev.
# Use unix:///var/run/docker.sock to target a local socket explicitly.
DEV_DOCKER_HOST=

# Staging host endpoint. Required for deploy staging, undeploy staging.
STAGING_DOCKER_HOST=

# Prod host endpoint. Reserved — recipes work when this is set, but no prod
# host is provisioned by this repository. Uncomment when ready.
# PROD_DOCKER_HOST=

# Image namespace for staging/prod pulls, e.g. ghcr.io/pandazxx
REGISTRY=

# Registry auth token for non-GHCR registries. GHCR uses GITHUB_TOKEN.
# REGISTRY_TOKEN=

# GID of the Docker socket's owning group on the host. Recipes probe this
# automatically via `alpine stat -c '%g' /var/run/docker.sock` when unset.
# DOCKER_GID=

# Path to the ssh-agent socket on the dev host, bound into the master
# container. Default covers the standard systemd user socket for uid 1000.
# MASTER_SSH_AUTH_SOCK_PATH=/run/user/1000/ssh-agent.sock

# Host port for singleton `just deploy` targets. Default 8080. Per-machine.
# Ignored by the dev shape (which uses Traefik hostname routing instead).
# MASTER_PORT=8080

# Host path to the Docker/Podman socket (default: /var/run/docker.sock).
# CONTAINER_SOCKET_PATH=/var/run/docker.sock

# ============================================================================
# SECTION B — Master service runtime secrets & config
#   Consumed by: docker-compose.yml `environment:` interpolation
# ============================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=

# MASTER_DRY_RUN=false
# MASTER_AGENT_BASE_IMAGE=
# MASTER_CODEX_AUTH_JSON_PATH=
# MASTER_SSH_KNOWN_HOSTS_PATH=
# MASTER_GIT_USER_NAME=
# MASTER_GIT_USER_EMAIL=
# AGENT_IDLE_TIMEOUT_SECONDS=3600
# AGENT_AUTH_REFRESH_INTERVAL_SECONDS=43200

# ---- Master: database (design: docs/design/backend-database-provider.md) ----
# Applies to staging/prod singleton deploys (`just deploy`). Dev (`just dev-up`)
# ignores these and always runs a per-branch bundled Postgres; its password
# defaults to a dev-only value (override with DEV_POSTGRES_PASSWORD).
#
# Pick exactly one mode for each singleton host:
#
#   Bundled Postgres (staging default): start the `postgres` service and
#   persist it in the postgres_data volume. Both lines are required.
#     COMPOSE_PROFILES=db-bundled
#     POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
#   Use a URL-safe password (hex): master splices it into the URL unescaped.
#
#   Managed database / SQLite: leave COMPOSE_PROFILES unset (no postgres
#   container) and set DATABASE_URL. Supported schemes: postgresql+psycopg,
#   sqlite+pysqlite, mysql+pymysql.
#     DATABASE_URL=postgresql+psycopg://user:pass@db.example.com:5432/master
#     DATABASE_URL=sqlite+pysqlite:////opt/codex-slack/data/master/master_data.db
#
# `just deploy` refuses to run when neither mode is configured. master refuses
# to start when DATABASE_URL is empty and a legacy master_data.db exists in the
# data volume; after migrating SQLite -> Postgres, set DATABASE_URL explicitly
# (see .sre/operations/deploy.md for the staging cut-over).
#
# COMPOSE_PROFILES=db-bundled
# POSTGRES_PASSWORD=
# DATABASE_URL=

# SQLAlchemy pool tunables (SQLite ignores them). Empty/unset = defaults.
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10

# ---- Master: agent-reply notifications ----------------------------------

# Externally reachable base URL of the web UI. Used to build deep links in
# notifications. If unset, notifications are sent without a clickable URL.
# MASTER_PUBLIC_URL=https://codex.example.com

# Discord incoming-webhook URL. Leave unset to disable Discord notifications.
# MASTER_NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram bot token + chat/channel ID. Both must be set to enable Telegram.
# MASTER_NOTIFY_TELEGRAM_BOT_TOKEN=
# MASTER_NOTIFY_TELEGRAM_CHAT_ID=

# Max characters of the agent reply shown as a preview (default: 200).
# Set to 0 to omit the preview entirely.
# MASTER_NOTIFY_PREVIEW_CHARS=200
