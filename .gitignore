# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Test and tool caches
.pytest_cache/

# Local logs
*.log
logs/
build/

# Local environment files
.env
*.secret

# Local Codex state
.codex/

# Frontend dependencies and lock file (installed on demand, not committed)
frontend/node_modules/
frontend/package-lock.json

# Frontend build output (regenerated by `npm run build` / Docker build — do not commit)
src/master/static/

# Pasted screenshots dropped into the worktree by the agent UI
pasted-image-*.png

# Agent worktree runtime state (created by Claude Code agent infrastructure)
.claude/worktrees/
.env.local.*
